      <style>
        :root {
          --primary: #1ab394;
          --primary-light: #e6f7f4;
          --accent: #2bbd9e;
          --bg-card: rgba(255, 255, 255, 0.92);
          --text-main: #2c3e50;
        }

        * {
          box-sizing: border-box;
          margin: 0;
          padding: 0;
        }

        body {
          font-family: 'Quicksand', 'Comfortaa', sans-serif;
          background: linear-gradient(135deg, #a8ebd9 0%, #76d7c4 50%, #48c9b0 100%);
          min-height: 100vh;
          display: flex;
          justify-content: center;
          align-items: center;
          color: var(--text-main);
          padding: 20px;
        }

        .container {
          background: var(--bg-card);
          backdrop-filter: blur(10px);
          border-radius: 24px;
          padding: 40px 30px;
          max-width: 480px;
          width: 100%;
          box-shadow: 0 20px 40px rgba(22, 160, 133, 0.25);
          border: 3px solid #ffffff;
          text-align: center;
        }

        .avatar-wrapper {
          position: relative;
          width: 130px;
          height: 130px;
          margin: 0 auto 20px;
        }

        .avatar {
          width: 100%;
          height: 100%;
          border-radius: 50%;
          object-fit: cover;
          border: 4px solid var(--primary);
          box-shadow: 0 8px 16px rgba(26, 179, 148, 0.3);
        }

        .status-badge {
          position: absolute;
          bottom: 5px;
          right: 5px;
          width: 22px;
          height: 22px;
          background-color: #2ecc71;
          border: 3px solid #ffffff;
          border-radius: 50%;
        }

        h1 {
          font-family: 'Comfortaa', cursive;
          font-size: 22px;
          color: #16a085;
          margin-bottom: 6px;
          font-weight: 700;
        }

        .subtitle {
          font-size: 14px;
          color: #7f8c8d;
          margin-bottom: 25px;
        }

        .stats-grid {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 15px;
          margin-bottom: 25px;
        }

        .stat-card {
          background: var(--primary-light);
          padding: 15px;
          border-radius: 16px;
          border: 1px solid #b2ece1;
        }

        .stat-card .number {
          font-size: 20px;
          font-weight: 700;
          color: var(--primary);
        }

        .stat-card .label {
          font-size: 12px;
          color: #566573;
          margin-top: 4px;
        }

